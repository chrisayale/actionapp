rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }
    
    // Orders collection
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // Establishments collection
    match /establishments/{establishmentId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Promotions collection
    match /promotions/{promotionId} {
      // Anyone (even non-authenticated) can read active promotions
      allow read: if resource.data.isActive == true;

      // Only authenticated users can create promotions for themselves
      // (we expect a userId field equal to request.auth.uid)
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Only the owner (or admin) can update/delete a promotion
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Sub-collection: interestedUsers (for tracking who liked/interested in a promotion)
      match /interestedUsers/{userId} {
        // Users can read/write their own like status
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Admins can read all
        allow read: if isAdmin();
      }
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}




