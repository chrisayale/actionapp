rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow users to write their own data
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow admins to read any user (this covers both individual reads and list queries)
      allow read: if isAdmin();
      // Allow reading any user document for authenticated users
      // This is needed so isAdmin() function can check the user's role
      // and to allow checking if any admin exists
      allow read: if request.auth != null;
      // Allow reading users collection to check if admin exists (for initial setup)
      // This is needed before authentication to determine if first admin should be created
      // WARNING: This allows reading all user documents. Consider restricting this in production
      // by using a Cloud Function to check admin existence instead
      allow read: if true; // Allow reading to check for admin existence during initial setup
      
      // Allow creating first admin user (when no admin exists yet)
      // This allows creating a user with role='admin' if authenticated via Firebase Auth
      allow create: if request.auth != null 
                    && request.resource.data.role == 'admin'
                    && request.resource.id == request.auth.uid;
    }
    
    // Orders collection
    match /orders/{orderId} {
      // Allow users to read their own orders
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow admins to read all orders (must be separate rule for list queries)
      allow read: if isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // Establishments collection
    match /establishments/{establishmentId} {
      // Allow users to read their own establishments
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow admins to read all establishments (must be separate rule for list queries)
      allow read: if isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Promotions collection
    match /promotions/{promotionId} {
      // Anyone (even non-authenticated) can read active promotions
      allow read: if resource.data.isActive == true;
      // Admins can read all promotions (including inactive ones)
      allow read: if isAdmin();

      // Only authenticated users can create promotions for themselves
      // (we expect a userId field equal to request.auth.uid)
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Only the owner (or admin) can update/delete a promotion
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Sub-collection: interestedUsers (for tracking who liked/interested in a promotion)
      match /interestedUsers/{userId} {
        // Users can read/write their own like status
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Admins can read all
        allow read: if isAdmin();
      }
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}




