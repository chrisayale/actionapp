rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images - le nom du fichier est {userId}.jpg
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      // Le fileName doit correspondre exactement à {uid}.jpg
      allow write: if request.auth != null && 
                      fileName == request.auth.uid + '.jpg';
    }
    
    // User profile images (alternative path)
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Order attachments
    match /orders/{orderId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.metadata.userId == request.auth.uid;
    }
    
    // Establishment images (logos, enseigne, documents)
    match /establishments/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}




